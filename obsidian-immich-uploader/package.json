{
  "name": "obsidian-immich-uploader",
  "version": "0.1.0",
  "description": "Obsidian plugin for uploading images to Immich with user-configured URL/API key.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --target=es2018 --outfile=main.js",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/state --external:@codemirror/view --format=cjs --target=es2018 --outfile=main.js --watch",
    "install:vault": "bash scripts/install-vault.sh"
  },
  "keywords": [
    "obsidian",
    "immich",
    "plugin",
    "image-upload"
  ],
  "author": "LSC / Hermes",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.2"
  }
}
